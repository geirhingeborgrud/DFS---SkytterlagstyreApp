<%- include('../partials/header') %>
<div class="page-head"><h1>E-post</h1><a class="btn" href="/epost/ny">Ny e-post</a></div>
<div class="card">
  <% if (!emails.length) { %><p class="empty">Ingen e-poster sendt ennå.</p><% } %>
  <div class="table-wrap"><table>
    <thead><tr><th>Sendt</th><th>Emne</th><th>Fra</th><th>Mottakere</th><th>Status</th></tr></thead>
    <% emails.forEach(e => { %>
      <tr><td class="nowrap small"><%= fmtDateTime(e.sent_at) %></td><td><a href="/epost/<%= e.id %>"><%= e.subject %></a><% if (e.document_ids.length) { %> <span class="badge">📎 <%= e.document_ids.length %></span><% } %></td>
        <td class="small"><%= e.sender_name %></td><td class="small"><%= e.recipients.length %></td>
        <td><span class="badge <%= e.status === 'sendt' ? 'ok' : e.status === 'feilet' ? 'red' : 'warn' %>"><%= e.status %></span></td></tr>
    <% }) %>
  </table></div>
</div>
<%- include('../partials/footer') %>
