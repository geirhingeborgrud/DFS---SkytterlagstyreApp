<%- include('partials/auth-top') %>
<p>Første gangs oppsett. Opprett skytterlaget og din egen administratorkonto.</p>
<form method="post" action="/oppsett">
  <%- include('partials/csrf') %>
  <label for="club">Skytterlagets navn</label>
  <input id="club" name="club" type="text" required value="<%= values.club || '' %>" placeholder="f.eks. Østre Bærum Skytterlag">
  <label for="name">Ditt navn</label>
  <input id="name" name="name" type="text" required value="<%= values.name || '' %>" autocomplete="name">
  <label for="email">Din e-post</label>
  <input id="email" name="email" type="email" required value="<%= values.email || '' %>" autocomplete="email">
  <label for="password">Passord (minst 10 tegn)</label>
  <input id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
  <label for="password2">Gjenta passord</label>
  <input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password">
  <button type="submit">Opprett</button>
</form>
<%- include('partials/auth-bottom') %>
