<%- include('partials/auth-top') %>
<p>Hei <%= invitee.name %>! Velg et passord for å logge inn.</p>
<form method="post" action="/invitasjon/<%= token %>">
  <%- include('partials/csrf') %>
  <input type="email" value="<%= invitee.email %>" autocomplete="username" readonly hidden>
  <label for="password">Nytt passord (minst 10 tegn)</label>
  <input id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
  <label for="password2">Gjenta passord</label>
  <input id="password2" name="password2" type="password" required minlength="10" autocomplete="new-password">
  <button type="submit">Lagre passord</button>
</form>
<%- include('partials/auth-bottom') %>
