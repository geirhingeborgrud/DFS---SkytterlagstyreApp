<div class="row">
  <div><label>Fornavn</label><input name="first_name" type="text" value="<%= member.first_name || '' %>" required></div>
  <div><label>Etternavn</label><input name="last_name" type="text" value="<%= member.last_name || '' %>" required></div>
  <div><label>Skytter-ID (MittDFS)</label><input name="shooter_id" type="text" value="<%= member.shooter_id || '' %>"></div>
  <div><label>Fødselsdato</label><input name="birth_date" type="date" value="<%= member.birth_date || '' %>"></div>
</div>
<div class="row">
  <div><label>E-post</label><input name="email" type="email" value="<%= member.email || '' %>"></div>
  <div><label>Mobil</label><input name="phone" type="tel" value="<%= member.phone || '' %>"></div>
  <div><label>Klasse</label><input name="class" type="text" value="<%= member.class || '' %>" placeholder="f.eks. 3, 5, V55, J"></div>
</div>
<div class="row">
  <div><label>Adresse</label><input name="address" type="text" value="<%= member.address || '' %>"></div>
  <div><label>Postnr</label><input name="postal_code" type="text" value="<%= member.postal_code || '' %>"></div>
  <div><label>Poststed</label><input name="city" type="text" value="<%= member.city || '' %>"></div>
</div>
<label>Notater</label><textarea name="notes"><%= member.notes || '' %></textarea>
