# Kopier til .env og fyll ut.
PORT=3000
# Lang tilfeldig streng – f.eks. resultatet av: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Offentlig adresse, brukes i lenker i e-post (invitasjoner, dokumentlenker)
BASE_URL=https://styre.dittskytterlag.no
# Sett til true når appen kjører bak HTTPS
SECURE_COOKIES=true
# Hvor database og opplastede filer lagres (standard: ./data)
# DATA_DIR=/var/lib/styreapp

# E-post (SMTP). Uten SMTP_HOST blir e-post bare simulert og logget i appen.
# Google Workspace / Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true og et app-passord.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
